# Copia este archivo a .env.local y rellena con tus valores.
# .env.local NO se sube al repo (está en .gitignore).
# En Vercel, configura estas mismas variables en Project Settings → Environment Variables.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-aqui

# Web3Forms (envío de feedback al email del equipo). Obtén tu access key
# gratis en https://web3forms.com — está protegido por filtro de dominio.
VITE_WEB3FORMS_KEY=tu-access-key-aqui

# OneSignal (notificaciones push diarias). App ID del proyecto Web Push.
# Crea cuenta gratis en https://onesignal.com → Add app → Web Push.
VITE_ONESIGNAL_APP_ID=tu-app-id-aqui
